    name: "liboss_tinyalsa_example_plugin_mixer",
    vendor: true,
    srcs: ["sample_mixer_plugin.c"],
    cflags: ["-Werror", "-Wno-unused-parameter"],
    header_libs: ["liboss_tinyalsa_headers"],
}
